# Plantilla de variables de entorno para el proyecto MLOps.
# Copiar este archivo a .env y rellenar con valores reales.
# El archivo .env esta en .gitignore y no se sube a Git.

# API key de Anthropic (para modo real con Claude)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Conexion a base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg2://airflow:airflow@postgres/airflow

# URI del servidor MLflow
MLFLOW_TRACKING_URI=http://mlserver-mlflow:5000
